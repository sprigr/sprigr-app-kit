{
  "name": "@sprigr/apps-pending-oauth",
  "version": "0.1.1",
  "description": "Single-use, TTL'd OAuth handshake state in a per-install D1 table, plus completion markers so a replayed callback reports already_connected.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean --tsconfig tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprigr/sprigr-app-kit.git",
    "directory": "packages/pending-oauth"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
