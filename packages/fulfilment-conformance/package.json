{
  "name": "@sprigr/apps-fulfilment-conformance",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup src/index.ts src/vitest.ts --format esm --dts --out-dir dist --clean --tsconfig tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprigr/sprigr-app-kit.git",
    "directory": "packages/fulfilment-conformance"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "description": "Conformance harness for the fulfilment-hub v1 interfaces: drives every op of fulfilment-hub/order_source and fulfilment-hub/fulfilment_provider against an adapter's handler map and checks the contract."
}
