        },
        "required": [
          "status"
        ]
      }
    },
    {
      "name": "mock_warehouse_get_stock",
      "description": "Snapshot stock levels from the mock warehouse fixture. Integer quantities, ISO 8601 UTC snapshot_at.",
      "handler": "src/handlers/provider.ts",
      "input_schema": {
        "type": "object",
        "properties": {
          "warehouse_key": {
            "type": "string"
          },
          "skus": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider_adapter": {
                  "type": "string"
                },
                "warehouse_key": {
                  "type": "string"
                },
                "sku": {
                  "type": "string"
                },
                "on_hand": {
                  "type": "number"
                },
                "reserved": {
                  "type": "number"
                },
                "held": {
                  "type": "number"
                },
                "snapshot_at": {
                  "type": "string"
                }
              },
              "required": [
                "provider_adapter",
                "warehouse_key",
                "sku",
                "on_hand",
                "reserved",
                "held",
                "snapshot_at"
              ]
            }
          }
        },
        "required": [
          "levels"
        ]
      }
    },
    {
      "name": "mock_warehouse_health",
      "description": "Credential and breaker state for this install. Always healthy: the mock has no upstream to fail.",
      "handler": "src/handlers/provider.ts",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "credentials_ok": {
            "type": "boolean"
          },
          "last_callback_at": {
            "type": "string"
          },
          "breaker_open": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "credentials_ok",
          "breaker_open"
        ]
      }
    },
    {
      "name": "mock_warehouse_advance",
      "description": "Shakedown lever, not part of the interface. Moves one request forward and emits what a real warehouse callback would: provider.order.accepted, then provider.shipment.created. Call it with no `to` to do both. `to=scan` emits one provider.shipment.event; `to=deliver` emits the four a carrier reports between the warehouse door and the doorstep and records the delivery. Both refuse a request that has not shipped. `to=cancel` emits provider.order.cancelled unless the row is already cancelled, in which case cancel_order has emitted it and a second emit would double-report one cancellation.",
      "handler": "src/handlers/provider.ts",
      "effects": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "fulfilment_request_id": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "enum": [
              "accept",
              "ship",
              "scan",
              "deliver",
              "cancel"
            ],
            "description": "Omit to accept then ship in one call. scan and deliver need a shipped request."
          },
          "carrier": {
            "type": "string"
          },
          "tracking_number": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "label_printed",
              "departed_warehouse",
              "first_scan",
              "destination_arrival",
              "delivered",
              "exception"
            ],
            "description": "to=scan only: which carrier scan to emit. Defaults to departed_warehouse."
          },
          "location": {
            "type": "string",
            "description": "to=scan only: overrides the stage's default location."
          },
          "detail": {
            "type": "string",
            "description": "to=scan only: free text the carrier would put on the scan."
          }
        },
        "required": [
          "fulfilment_request_id"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "stage": {
            "type": "string"
          },
          "provider_ref": {
            "type": "string"
          },
          "emitted": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "reason": {
            "type": "string"
          },
          "scans": {
            "type": "array",
            "description": "The scans this call emitted, in order.",
            "items": {
              "type": "object"
            }
          },
          "delivered_at": {
            "type": "string",
            "description": "ISO 8601 UTC. Set by to=deliver."
          }
        },
        "required": [
          "ok"
        ]
      }
    }
  ],
