      "effects": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "fulfilment_request_id": {
            "type": "string",
            "description": "The hub id. The idempotency key."
          },
          "order_id": {
            "type": "string"
          },
          "source_number": {
            "type": "string"
          },
          "warehouse_key": {
            "type": "string"
          },
          "ship_to": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "company": {
                "type": "string"
              },
              "line1": {
                "type": "string"
              },
              "line2": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "postcode": {
                "type": "string"
              },
              "country": {
                "type": "string",
                "description": "ISO 3166-1 alpha-2."
              },
              "phone": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "line1",
              "country"
            ]
          },
          "customer_email": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line_id": {
                  "type": "string"
                },
                "sku": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number",
                  "description": "Integer."
                },
                "unit_price_minor": {
                  "type": "number",
                  "description": "Integer minor units."
                },
                "currency": {
                  "type": "string"
                }
              },
              "required": [
                "line_id",
                "sku",
                "quantity"
              ]
            }
          },
          "currency": {
            "type": "string"
          },
          "total_minor": {
            "type": "number",
            "description": "Integer minor units."
          },
          "notes": {
            "type": "string"
          },
          "callback_hint": {
            "type": "string"
          }
        },
        "required": [
          "fulfilment_request_id",
          "order_id",
          "warehouse_key",
          "lines"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "queued",
              "rejected"
            ],
            "description": "Async ack. The outcome arrives as a provider.* event."
          },
          "provider_ref": {
            "type": "string",
            "description": "The warehouse's own id. Stable for a given fulfilment_request_id."
          },
          "reason": {
            "type": "string",
            "description": "Required when status is rejected."
          }
        },
        "required": [
          "status"
        ]
      }
    },
    {
      "name": "mock_warehouse_cancel_order",
      "description": "Cancel a queued or accepted request. Idempotent on the row. Emits the outcome immediately: provider.order.cancelled when the cancel is recorded, provider.order.cancel_refused with the reason when the request has already shipped or been delivered. The ack alone is not the answer - the hub closes its request on the event.",
      "handler": "src/handlers/provider.ts",
      "effects": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "fulfilment_request_id": {
            "type": "string"
          },
          "provider_ref": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "fulfilment_request_id",
          "provider_ref",
          "reason"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "queued",
              "rejected"
            ],
            "description": "Async ack. The outcome arrives as a provider.* event."
          },
          "reason": {
            "type": "string",
            "description": "Required when status is rejected."
          }
        },
        "required": [
          "status"
        ]
      }
    },
    {
      "name": "mock_warehouse_get_order_status",
      "description": "Current provider-side status of one request, with tracking once it has shipped.",
