{
  "sprigr_app": {
    "version": "1"
  },
  "metadata": {
    "name": "Mock Warehouse",
    "slug": "mock-warehouse",
    "version": "0.0.3",
    "description": "Deterministic fulfilment-hub/fulfilment_provider implementer. Accepts every push, holds it until mock_warehouse_advance fires provider.order.accepted then provider.shipment.created, drives the carrier scans and the delivery through provider.shipment.event, and answers get_stock from a fixed fixture. The shakedown fixture for the hub, and the worked reference for a real warehouse adapter.",
    "author": {
      "name": "Sprigr Company",
      "email": "platform@sprigr.com"
    },
    "category": "operations",
    "tags": [
      "reference",
      "fulfilment",
      "interfaces",
      "fixture"
    ]
  },
  "kind": "tool",
  "runtime": {
    "entry": "src/app/page.tsx",
    "tier": "ssr",
    "framework": "next"
  },
  "permissions": {
    "scopes": [
      "tools:register"
    ]
  },
  "migrations": [
    {
      "file": "migrations/0001_init.sql",
      "version": 1,
      "description": "The one table: the push_order idempotency record and its stage."
    },
    {
      "file": "migrations/0002_scan_history.sql",
      "version": 2,
      "description": "Adds scans_json and delivered_at to the one request row: the carrier-scan history and the delivery stamp."
    }
  ],
  "tools": [
    {
      "name": "mock_warehouse_describe",
      "description": "Report this adapter slug and its capability block. The hub reads capabilities to choose a path and never infers a limit from error text.",
      "handler": "src/handlers/provider.ts",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "adapter_slug": {
            "type": "string"
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "supports_cancel": {
                "type": "boolean"
              },
              "supports_split": {
                "type": "boolean"
              },
              "supports_hold": {
                "type": "boolean"
              },
              "tracking_mode": {
                "type": "string",
                "enum": [
                  "push",
                  "poll",
                  "scrape"
                ]
              },
              "stock_mode": {
                "type": "string",
                "enum": [
                  "snapshot",
                  "delta",
                  "none"
                ]
              },
              "countries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "supports_cancel",
              "supports_split",
              "supports_hold",
              "tracking_mode",
              "stock_mode",
              "countries"
            ]
          }
        },
        "required": [
          "adapter_slug",
          "capabilities"
        ]
      }
    },
    {
      "name": "mock_warehouse_list_warehouses",
      "description": "List the warehouses the hub may route to. warehouse_key is the opaque id push_order takes.",
      "handler": "src/handlers/provider.ts",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "warehouses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "warehouse_key": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "cutoff_local_time": {
                  "type": "string"
                },
                "active": {
                  "type": "boolean"
                }
              },
              "required": [
                "warehouse_key",
                "name",
                "country",
                "active"
              ]
            }
          }
        },
        "required": [
          "warehouses"
        ]
      }
    },
    {
      "name": "mock_warehouse_push_order",
      "description": "Queue one fulfilment request at a mock warehouse. Idempotent on fulfilment_request_id: a repeat call returns the same provider_ref and does not reach the warehouse again. Acknowledges immediately; the outcome arrives as provider.order.accepted (or rejected / error).",
