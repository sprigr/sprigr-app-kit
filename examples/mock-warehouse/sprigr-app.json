  "events": {
    "emits": [
      {
        "name": "provider.order.accepted",
        "description": "The mock warehouse accepted a queued request. Fired by mock_warehouse_advance.",
        "scope": "per_install",
        "schema": {
          "type": "object",
          "properties": {
            "adapter_slug": {
              "type": "string"
            },
            "fulfilment_request_id": {
              "type": "string"
            },
            "provider_ref": {
              "type": "string"
            },
            "warehouse_key": {
              "type": "string"
            }
          },
          "required": [
            "adapter_slug",
            "fulfilment_request_id",
            "provider_ref",
            "warehouse_key"
          ]
        }
      },
      {
        "name": "provider.order.rejected",
        "description": "The warehouse refused the request outright. Not retryable. Declared because push_order acknowledges asynchronously, so this is where a refusal would arrive.",
        "scope": "per_install",
        "schema": {
          "type": "object",
          "properties": {
            "adapter_slug": {
              "type": "string"
            },
            "fulfilment_request_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "adapter_slug",
            "fulfilment_request_id",
            "reason"
          ]
        }
      },
      {
        "name": "provider.order.error",
        "description": "A transient failure pushing the request. Carries retryable.",
        "scope": "per_install",
        "schema": {
          "type": "object",
          "properties": {
            "adapter_slug": {
              "type": "string"
            },
            "fulfilment_request_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "adapter_slug",
            "fulfilment_request_id",
            "reason",
            "retryable"
          ]
        }
      },
      {
        "name": "provider.order.cancelled",
        "description": "A cancellation completed. Fired by mock_warehouse_cancel_order the moment it records the cancel, because the hub keeps its request open until this arrives; mock_warehouse_advance with to=cancel fires it for a request cancelled some other way, and stays quiet on an already-cancelled row.",
        "scope": "per_install",
        "schema": {
          "type": "object",
          "properties": {
            "adapter_slug": {
              "type": "string"
            },
            "fulfilment_request_id": {
              "type": "string"
            },
            "provider_ref": {
              "type": "string"
            }
          },
          "required": [
            "adapter_slug",
            "fulfilment_request_id",
            "provider_ref"
          ]
        }
      },
      {
        "name": "provider.order.cancel_refused",
        "description": "The warehouse refused to cancel (already shipped or delivered). Fired by mock_warehouse_cancel_order alongside the rejected ack: a refusal the hub never hears leaves the request open the same way an unemitted success does.",
        "scope": "per_install",
        "schema": {
          "type": "object",
          "properties": {
            "adapter_slug": {
              "type": "string"
            },
            "fulfilment_request_id": {
              "type": "string"
            },
            "provider_ref": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "adapter_slug",
            "fulfilment_request_id",
            "provider_ref",
            "reason"
          ]
        }
      },
      {
        "name": "provider.shipment.created",
        "description": "A shipment left the mock warehouse, with carrier and tracking. Fired by mock_warehouse_advance.",
        "scope": "per_install",
        "schema": {
          "type": "object",
          "properties": {
            "adapter_slug": {
              "type": "string"
            },
            "fulfilment_request_id": {
              "type": "string"
            },
            "provider_ref": {
              "type": "string"
            },
            "shipment": {
              "type": "object"
            }
          },
          "required": [
            "adapter_slug",
            "fulfilment_request_id",
            "provider_ref",
            "shipment"
          ]
        }
      },
      {
        "name": "provider.shipment.event",
        "description": "A carrier scan on a shipment: the hub's only source of transit and delivery. Fired by mock_warehouse_advance with to=scan (one) or to=deliver (the four a real carrier reports). The hub correlates on provider_shipment_ref and dedups on provider_event_ref.",
        "scope": "per_install",
        "schema": {
          "type": "object",
          "properties": {
            "adapter_slug": {
              "type": "string"
            },
            "provider_shipment_ref": {
              "type": "string"
            },
            "tracking_number": {
              "type": "string"
            },
            "stage": {
              "type": "string",
              "enum": [
                "label_printed",
                "departed_warehouse",
                "first_scan",
                "destination_arrival",
                "delivered",
                "exception"
              ]
            },
            "occurred_at": {
              "type": "string",
              "description": "ISO 8601 UTC, Z suffix."
            },
            "location": {
              "type": "string"
            },
            "provider_event_ref": {
              "type": "string",
              "description": "Dedup key. mwe_<fulfilment_request_id>_<stage>_<n>."
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "adapter_slug",
            "provider_shipment_ref",
            "tracking_number",
            "stage",
            "occurred_at",
            "provider_event_ref"
          ]
        }
      }
    ]
  }
